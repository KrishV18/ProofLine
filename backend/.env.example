# ProofLine Environment Configuration
# Copy this to .env (or backend/.env) and fill in your values

# Database Configuration (Defaults to SQLite for local development; switch to PostgreSQL when ready)
DATABASE_URL=sqlite:///./proofline.db
# DATABASE_URL=postgresql+psycopg://proofline:proofline@localhost:5432/proofline

# Authentication & Security
JWT_SECRET=change-me-in-production-proofline-round2-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM / AI Configuration
# 1. Put your LLM API Key here (Groq, Gemini, OpenAI, or OpenRouter):
LLM_API_KEY=your-api-key-here

# 2. LLM Model:
# Groq: openai/gpt-oss-120b / openai/gpt-oss-20b / qwen/qwen3.8-27b
# Google Gemini: gemini-1.5-flash / gemini-2.0-flash / gemini-pro
# OpenAI: gpt-4o-mini / gpt-4o
LLM_MODEL=openai/gpt-oss-120b

# 3. LLM Base URL:
# For Groq:
LLM_BASE_URL=https://api.groq.com/openai/v1
# For Google Gemini (OpenAI compatibility endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# For OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# For OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Mock AI Fallback: Set to true if you want to test without an LLM API key
# (ProofLine will automatically fall back to mock AI heuristics if LLM_API_KEY is empty)
MOCK_AI=false

# CORS Configuration
CORS_ORIGINS=*

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=false
