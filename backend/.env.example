# ProofLine — environment variable reference
# Copy to .env and fill in real values.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://proofline:proofline@localhost:5432/proofline

# ── Test database (used by pytest when TEST_DATABASE_URL is set) ──────────────
TEST_DATABASE_URL=postgresql+psycopg://proofline:proofline@localhost:5432/proofline_test

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
